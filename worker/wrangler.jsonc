
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alexandrasfloral-api",
  "main": "src/index.js",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": ["nodejs_compat"],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "74c1268806bc49f498e06e88497a4a60"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PRODUCT_IMAGES",
      "bucket_name": "alexandras-floral-images"
    }
  ],
  "ratelimits": [
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "2026112001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "LOGIN_IP_LIMITER",
      "namespace_id": "2026112002",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "ORDER_LIMITER",
      "namespace_id": "2026112101",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "ENQUIRY_LIMITER",
      "namespace_id": "2026112102",
      "simple": {
        "limit": 15,
        "period": 60
      }
    }
  ]
}
